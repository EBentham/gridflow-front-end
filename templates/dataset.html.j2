{#- The dataset page, from the locked anatomy (DESIGN.md "Dataset page anatomy", locked 2026-09-27).
    One template for every dataset page and every family page. The page descends through the strata:
    petrol hero, topsoil (what it is, how it is used, the chart), bronze (the raw feed), silver (the frame
    and its guide), gold (the workbench call and the demo notebook), deep (related datasets).
    `v` is the view model built by build.page_view(); every word on the page comes from the vault note's
    `page:` block or from the fixed template copy below. A page whose note has no `page:` block yet is
    blank (`v.blank`, from build.blank_view()): the hero's breadcrumb, name and id, nothing else. -#}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ v.title }}: {{ v.vendor_label }} data in gridflow</title>
  <meta name="description" content="{{ v.summary_plain }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&amp;family=Hanken+Grotesk:ital,wght@0,400..700;1,400..600&amp;family=Red+Hat+Mono:wght@400;500&amp;display=swap">
  <link rel="stylesheet" href="../../assets/theme.css">
  <link rel="stylesheet" href="../../assets/dataset.css">
  {%- if not v.blank and v.record.fold_css %}
  {#- this frame's fold widths: below each, the columns that need it fold behind the ellipsis #}
  <style>
{{ v.record.fold_css }}
  </style>
  {%- endif %}
</head>
<body data-page="dataset" data-root="../../" data-screen-label="Dataset {{ v.key }}">
  {#- a blank page has no deep band of its own, so it is not `.ds` and site.js gives it the site footer -#}
  <main id="main" class="{{ 'ds-blank' if v.blank else 'ds' }}">
    {#- 1. petrol hero -#}
    <section class="stratum stratum--sky" aria-labelledby="ds-h">
      <div class="wrap ds-hero">
        <div class="ds-hero__id">
          <nav class="ds-crumb" aria-label="Breadcrumb"><a href="../../data-sources.html">Data sources</a> / <a href="../{{ v.vendor_id }}.html">{{ v.vendor_label }}</a></nav>
          <h1 class="h-hero ds-hero__h" id="ds-h">{{ v.title }}</h1>
          <p class="ds-keys">{% for c in v.chips %}<code class="ds-chip"{% if c.id %} id="{{ c.id }}"{% endif %}>{{ c.key | breakable }}</code>{% endfor %}</p>
        </div>
        {%- if not v.blank %}
        <div class="ds-hero__facts">
          <p class="ds-one">{{ v.summary | md_inline | safe }}</p>
          <dl class="ds-facts">
            {%- for label, value in v.facts %}
            <div><dt>{{ label }}</dt><dd>{{ value | safe }}</dd></div>
            {%- endfor %}
          </dl>
        </div>
        {%- endif %}
      </div>
      <figure class="landscape ds-land">
        {% include "_partials/landscape/" ~ v.landscape ~ ".svg.j2" %}
      </figure>
    </section>
    {%- if v.blank %}
    {#- the drawing's ground runs on into a band of topsoil, so the footer's wave never reaches it -#}
    <div class="stratum stratum--topsoil stratum--flush ds-blank__soil" aria-hidden="true"></div>
    {%- else %}

    {#- 2. topsoil: what it is, how it is used, then the chart with its key beside it -#}
    <section class="stratum stratum--topsoil stratum--flush" aria-labelledby="what-h">
      <div class="wrap ds-about">
        <div class="ds-what">
          <h2 class="h-fig" id="what-h">What it is</h2>
          <div class="prose"><p>{{ v.what_it_is | md_inline | safe }}</p></div>
        </div>
        <div class="ds-how">
          <h2 class="h-fig">How it’s used</h2>
          <ul class="ds-uses">
            {%- for use in v.how_used %}
            <li>{{ use | md_inline | safe }}</li>
            {%- endfor %}
          </ul>
        </div>
      </div>
      {%- if v.chart %}
      <figure class="wrap ds-chart" aria-labelledby="chart-h">
        <figcaption class="ds-chart__head">
          <h2 class="h-fig" id="chart-h">{{ v.chart.title }}</h2>
          <p class="caption">{{ v.chart.caption | md_inline | safe }}</p>
        </figcaption>
        <div class="ds-chart__body">
          <div class="ds-chart__plot">{{ v.chart.wide | safe }}{{ v.chart.narrow | safe }}</div>
          <ul class="ds-key" aria-label="Key to the chart">
            {%- for e in v.chart.key %}
            <li>{{ e.mark | safe }}<div><p class="ds-key__n">{{ e.label }}{% if e.codes %} <code class="ds-key__c">{{ e.codes }}</code>{% endif %}</p>{% if e.note %}<p class="ds-key__d">{{ e.note | md_inline | safe }}</p>{% endif %}</div></li>
            {%- endfor %}
          </ul>
        </div>
      </figure>
      {%- endif %}
      {%- if v.map %}
      {#- where the data is taken: the sites on a map, each a link to its row in the table (the no-script path);
          site.js adds the card that opens on hover, focus or tap -#}
      <figure class="wrap ds-map wm" aria-labelledby="map-h">
        <figcaption class="ds-chart__head">
          <h2 class="h-fig" id="map-h">{{ v.map.title }}</h2>
          <p class="caption">{{ v.map.caption | md_inline | safe }}</p>
        </figcaption>
        <div class="ds-map__body">
          <div class="wm-plot">{{ v.map.svg | safe }}<div class="wm-card" aria-hidden="true" hidden></div></div>
          <div class="wm-side">
            <p class="caption wm-hint" hidden>The table scrolls sideways to its statistics.</p>
            <div class="wm-tw" role="region" tabindex="0" aria-label="The {{ v.map.count }} sites, one row each">
              <table class="wm-t">
                <thead><tr>{% for c in v.map.columns %}<th scope="col"{% if c.num %} class="num"{% endif %}>{{ c.text }}</th>{% endfor %}</tr></thead>
                {%- for g in v.map.groups %}
                <tbody>
                  {%- if g.name %}
                  <tr class="wm-gh"><th scope="colgroup" colspan="{{ v.map.columns | length }}">{{ g.name }}</th></tr>
                  {%- endif %}
                  {%- for r in g.rows %}
                  <tr id="site-{{ r.name }}" data-site="{{ r.name }}"><th scope="row"><span class="wm-sw"{% if r.paint %} style="--p:{{ r.paint }}"{% endif %} aria-hidden="true"></span><span class="wm-n">{{ r.label }}</span> <code class="wm-code">{{ r.name }}</code></th><td class="wm-c">{{ r.requested }}</td><td class="wm-c">{{ r.answered }}</td><td class="num">{{ r.apart }}</td>{% for s in r.stats %}<td{% if s.num %} class="num"{% endif %}>{{ s.text }}{% if s.sub %} <span class="wm-sub">{{ s.sub }}</span>{% endif %}</td>{% endfor %}</tr>
                  {%- endfor %}
                </tbody>
                {%- endfor %}
              </table>
            </div>
            {%- for n in v.map.notes %}
            <p class="caption wm-note">{{ n | md_inline | safe }}</p>
            {%- endfor %}
          </div>
        </div>
      </figure>
      {%- endif %}
    </section>

    {#- 3. bronze: the vendor's raw URL and the gridflow calls that ingest it -#}
    <section class="stratum stratum--bronze" aria-labelledby="raw-h">
      <p class="stratum__name" aria-hidden="true">bronze, the response as fetched</p>
      <div class="wrap ds-split">
        <div class="ds-lead">
          <h2 class="h-fig" id="raw-h">The raw feed</h2>
          <p>{{ v.raw.note | md_inline | safe }}</p>
        </div>
        <div class="ds-wells">
          {%- if v.variants %}
          <ul class="ds-variants" aria-label="The variants">
            {%- for m in v.variants %}
            <li id="{{ m.slug }}">
              <p class="ds-variants__h"><code>{{ m.key }}</code>{% if m.code %} <span>{{ m.code }}</span>{% endif %}</p>
              <p class="ds-variants__d">{{ m.differs | md_inline | safe }}</p>
              <pre class="ds-well">{{ m.request | safe }}</pre>
            </li>
            {%- endfor %}
          </ul>
          {%- else %}
          {%- for req in v.raw.requests %}
          <pre class="ds-well" aria-label="The vendor request">{{ req | safe }}</pre>
          {%- endfor %}
          {%- endif %}
          <pre class="ds-well" aria-label="The gridflow commands">{% for c in v.raw.commands %}{% if c.comment %}<span class="ln ds-cm"># {{ c.comment }}</span>{% endif %}<span class="ln">{{ c.run }}</span>{% endfor %}</pre>
        </div>
      </div>
    </section>

    {#- 4. silver: the sample rows as a Polars frame (folded columns open behind `…`), then the column guide -#}
    {%- set r = v.record %}
    <section class="stratum stratum--silver" aria-labelledby="sv-h">
      <p class="stratum__name" aria-hidden="true">silver, typed and validated</p>
      <div class="wrap">
        <h2 class="h-fig" id="sv-h">Schema and sample rows</h2>
        <div class="spec">
          <p class="spec__cap"><code class="spec__shape">shape: {{ r.shape }}</code> <span>{{ r.caption | md_inline | safe }}</span></p>
          <div class="fw" role="region" tabindex="0" aria-label="{{ r.aria }}">
            <table class="pl">
              <thead>
                <tr class="nm">
                  {%- for c in r.columns %}
                  <th scope="col" id="c-{{ c.name }}"{% if c.folded %} class="fc"{% endif %}{% if c.tier %} data-w="{{ c.tier }}"{% endif %}>{{ c.name }}{% if c.key %}<span class="k" aria-hidden="true"></span><span class="sr-only"> (identifies a row)</span>{% endif %}</th>
                  {%- endfor %}
                  {%- if r.n_folded or r.el_tier %}
                  <th scope="col" class="el"{% if not r.n_folded %} data-e="{{ r.el_tier }}"{% endif %}><input type="checkbox" class="fx sr-only" id="fx"><label for="fx"><span aria-hidden="true">…</span><span class="sr-only">Show the folded columns</span></label></th>
                  {%- endif %}
                </tr>
                <tr class="dt">{% for c in r.columns %}<td{% if c.folded %} class="fc"{% endif %}{% if c.tier %} data-w="{{ c.tier }}"{% endif %}>{{ c.dtype }}</td>{% endfor %}{% if r.n_folded or r.el_tier %}<td class="el"{% if not r.n_folded %} data-e="{{ r.el_tier }}"{% endif %}><label for="fx" aria-hidden="true"></label></td>{% endif %}</tr>
              </thead>
              <tbody>
                {%- for row in r.rows %}
                <tr>{% for c in r.columns %}{% set val = row[loop.index0] %}<td{% if c.num or c.folded %} class="{{ 'num' if c.num }}{{ ' ' if c.num and c.folded }}{{ 'fc' if c.folded }}"{% endif %}{% if c.tier %} data-w="{{ c.tier }}"{% endif %}>{% if val is none %}<span class="nl">null</span>{% else %}{{ val }}{% endif %}</td>{% endfor %}{% if r.n_folded or r.el_tier %}<td class="el"{% if not r.n_folded %} data-e="{{ r.el_tier }}"{% endif %}><label for="fx" aria-hidden="true">…</label></td>{% endif %}</tr>
                {%- endfor %}
              </tbody>
            </table>
          </div>
          <div class="guide" role="group" aria-label="Column guide">
            <div class="g-grp">
              <p class="g-h" id="gk"><span class="k" aria-hidden="true"></span>Identifies a row</p>
              <dl aria-labelledby="gk">
                {%- for e in r.keyed %}
                <div class="g-r" data-k="{{ e.k }}"{% if e.folded %} data-f=""{% endif %}{% if e.tier %} data-w="{{ e.tier }}"{% endif %}><dt><a href="#c-{{ e.name }}">{{ e.name }}</a></dt><dd>{{ e.meaning | md_inline | safe }}</dd></div>
                {%- endfor %}
              </dl>
            </div>
            {%- if r.others %}
            <div class="g-grp">
              <p class="g-h" id="go">Other columns</p>
              <dl aria-labelledby="go">
                {%- for e in r.others %}
                <div class="g-r" data-k="{{ e.k }}"{% if e.folded %} data-f=""{% endif %}{% if e.tier %} data-w="{{ e.tier }}"{% endif %}><dt><a href="#c-{{ e.name }}">{{ e.name }}</a></dt><dd>{{ e.meaning | md_inline | safe }}</dd></div>
                {%- endfor %}
              </dl>
            </div>
            {%- endif %}
          </div>
        </div>
      </div>
    </section>

    {#- 5. gold: the workbench call, then the demo notebook that opens in place -#}
    <section class="stratum stratum--gold" aria-labelledby="gd-h">
      <p class="stratum__name" aria-hidden="true">gold, served to the notebook</p>
      <div class="wrap ds-split ds-gold">
        <div class="ds-lead">
          <h2 class="h-fig" id="gd-h">Query it from a notebook</h2>
          <p>{{ v.notebook.lead | md_inline | safe }}</p>
          <div class="ds-ctl">
            <button class="btn ds-open" type="button" aria-expanded="false" aria-controls="nb-demo nb-tools" data-call="nb-call">Open the demo notebook</button>
            <div class="ds-tools" id="nb-tools" hidden>
              <button class="ds-btn-2" type="button" data-copy="nb-src">Copy notebook</button>
              <p class="ds-status" role="status"></p>
              <p class="ds-need">Needs <a href="https://github.com/EBentham/gridflow">gridflow</a> and <a href="https://github.com/EBentham/gridflow-models">gridflow-models</a> installed, with {{ v.notebook.needs }} ingested.</p>
            </div>
          </div>
        </div>
        <div class="ds-nbcol">
          <figure class="nb ds-nb" id="nb-call" aria-label="The setup cell, then the call">
            <div class="nb-bar"><span class="nb-tab">{{ v.notebook.tab }}</span><span class="nb-kern">gridflow_models</span></div>
            <div class="nb-body">
              {%- for c in v.notebook.call %}
              <div class="cell"><span class="pr">[{{ c.n }}]:</span><pre class="in">{{ c.html | safe }}</pre></div>
              {%- endfor %}
            </div>
          </figure>
          <div class="ds-demo" id="nb-demo" hidden>
            <figure class="nb ds-nb" aria-label="{{ v.notebook.aria }}">
              <div class="nb-bar"><span class="nb-tab">{{ v.notebook.tab }}</span><span class="nb-kern">gridflow_models</span></div>
              <div class="nb-body">
                {%- for c in v.notebook.cells %}
                <div class="cell"><span class="pr">[{{ c.n }}]:</span><pre class="in">{{ c.html | safe }}</pre></div>
                {%- for o in c.outputs %}
                <div class="cell out"><span class="pr">[{{ c.n }}]:</span>{{ o | safe }}</div>
                {%- endfor %}
                {%- endfor %}
              </div>
              <textarea class="ds-nb-src" id="nb-src" readonly hidden aria-label="The notebook as Python">{{ v.notebook.source }}</textarea>
            </figure>
          </div>
        </div>
      </div>
    </section>

    {#- 6. deep: related datasets only -#}
    <section class="stratum stratum--deep" aria-labelledby="rel-h">
      <div class="wrap ds-split ds-rel">
        <h2 class="h-fig" id="rel-h">Related datasets</h2>
        <ul class="ds-rel__list">
          {%- for r in v.related %}
          <li><a href="{{ r.href }}"><code>{{ r.key }}</code></a><p>{{ r.note | md_inline | safe }}</p></li>
          {%- endfor %}
        </ul>
      </div>
    </section>
    {%- endif %}
  </main>
  <script src="../../assets/site.js"></script>
</body>
</html>
